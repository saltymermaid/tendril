# Database
DATABASE_URL=postgresql+asyncpg://tendril:tendril@db:5432/tendril
POSTGRES_USER=tendril
POSTGRES_PASSWORD=tendril
POSTGRES_DB=tendril

# Auth
SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=user@example.com
ENABLE_DEV_LOGIN=true

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tendril

# Push Notifications (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# App
APP_NAME=Tendril
DEBUG=true
CORS_ORIGINS=http://localhost:5173
# BASE_URL=https://tendril.garden  # Set in production to fix OAuth redirect_uri scheme

# MCP Server (Claude.ai connector)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_CLIENT_ID=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
MCP_CLIENT_SECRET=
MCP_TOKEN_SECRET=
# Comma-separated. Add the MCP Inspector callback here for local testing, e.g.
# https://claude.ai/api/mcp/auth_callback,http://localhost:6274/oauth/callback/debug
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
